{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "secret",
  "main": "./src/worker/index.ts",
  "compatibility_date": "2026-11-09",
  "assets": {
    // The Cloudflare Vite plugin points this at its client build output.
    "directory": "./dist/client",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "routes": [{ "pattern": "secret.tonytang.dev", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
  // Request URLs must not land in Cloudflare's logs or traces (spec amendment 2).
  "observability": {
    "enabled": false,
    "logs": { "enabled": false, "invocation_logs": false },
    "traces": { "enabled": false },
  },
}
