{
  "name": "secret",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "typecheck": "effect-tsgo tsc -b",
    "lint": "effect-tsgo oxlint --type-aware --deny-warnings --report-unused-disable-directives-severity=error",
    "lint:disable-reasons": "node tools/check-disable-reasons.mjs",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "vitest run",
    "knip": "knip",
    "check": "npm run typecheck && npm run lint && npm run lint:disable-reasons && npm run format:check && npm test && npm run knip",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "effect": "4.1.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261109.1",
    "@effect/tsgo": "0.67.5",
    "@effect/vitest": "4.1.2",
    "@types/node": "26.6.6",
    "knip": "6.44.2",
    "lefthook": "2.2.2",
    "oxfmt": "0.78.0",
    "oxlint": "1.92.0",
    "oxlint-tsgolint": "7.0.2006",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
